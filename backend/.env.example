# ==============================================================================
# PYROSHARMONIZER — PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================

# Database Connection (PostgreSQL 16 + PostGIS 3.4)
# Mapeado a puerto 5001 en el host mediante docker-compose.yml:
DATABASE_URL=postgresql://pyros_user:pyros_password@localhost:5001/pyrosharmonizer_db

# NASA FIRMS API Map Key
# Obtén tu token gratis en: https://firms.modaps.eosdis.nasa.gov/api/
# Reemplaza 1234 con la clave alfanumérica proporcionada por NASA FIRMS:
NASA_FIRMS_MAP_KEY=1234
NASA_MAP_KEY=1234

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=PyrosHarmonizer-DataEngine

# GeoSpatial Defaults (Bolivia & Chiquitania Bounding Box)
# BBOX format: min_lon,min_lat,max_lon,max_lat
CHIQUITANIA_BBOX=-64.5,-20.5,-57.5,-13.5
BOLIVIA_BBOX=-69.65,-22.90,-57.45,-9.67
