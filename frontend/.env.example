# PyrosHarmonizer Frontend — Variables de Entorno (NASA Space Apps 2026)
# URL base del backend FastAPI + PostGIS (API v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Caso de estudio inicial por defecto
NEXT_PUBLIC_DEFAULT_REGION=chiquitania

# Habilitar fallback determinista local si el backend no responde (NFR-006)
NEXT_PUBLIC_ENABLE_OFFLINE_FALLBACK=true
